{
  "name": "el-laboratorio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @el-laboratorio/web --filter @el-laboratorio/api dev",
    "build": "pnpm --filter @el-laboratorio/database generate && pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm --filter @el-laboratorio/database generate && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @el-laboratorio/database generate",
    "db:migrate": "pnpm --filter @el-laboratorio/database migrate"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
